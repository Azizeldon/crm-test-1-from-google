function confirmNuke() {
  if (!isAdmin) return;
  showConfirm('⚠️ SUPPRIMER TOUTE LA BASE ?', 'Tous les contacts seront définitivement effacés. Action irréversible.', async () => {
    const { error } = await sb.from('contacts').delete().neq('id','00000000-0000-0000-0000-000000000000');
