function openCModal(c = null) {
  editId = c?.id || null;
  modalContact = c;
  $('m-c-title').textContent = c ? `${c.prenom || ''} ${c.nom || ''}`.trim() || 'Fiche Contact' : 'Nouveau Contact';
  $('fp').value  = c?.prenom   || '';
  $('fn').value  = c?.nom      || '';
  $('fe').value  = c?.email    || '';
  $('ft').value  = c?.phone    || '';
  $('fs').value  = c?.societe  || '';
  $('fst').value = c?.status   || 'lead';
  $('fno').value = c?.notes    || '';
  $('fca').value = c?.ca_estime || '';
  $('m-edit-btns').classList.toggle('hidden', !c);
  $('m-del').classList.toggle('hidden', !c || !isAdmin);
  $('m-ai-box').classList.add('hidden');
  if (c?.phone) {
    $('m-call').href = 'tel:' + c.phone;
    $('m-wa').href   = 'https://wa.me/' + c.phone.replace(/\D/g,'');
  }
  showModal('m-contact');
}

function closeCModal() { hideModal('m-contact'); editId = null; modalContact = null; }

async function saveC() {
  const c = {
    prenom: $('fp').value.trim(), nom: $('fn').value.trim(),
    email: $('fe').value.trim(), phone: $('ft').value.trim(),
    societe: $('fs').value.trim(), status: $('fst').value,
    notes: $('fno').value.trim(), ca_estime: parseFloat($('fca').value) || 0,
    user_id: me.id, updated_at: new Date().toISOString()
  };
  if (!c.prenom && !c.nom && !c.email) return toast('⚠️ Remplissez au moins un champ identifiant', 'warning');
  if (editId) c.id = editId; else c.created_at = new Date().toISOString();

  if (online) {
    const { data, error } = await sb.from('contacts').upsert(c).select().single();
    if (error) { addPending({ t:'upsert', d: c }); toast('📱 Sauvegardé localement', 'warning'); }
    else {
      toast('✅ Contact sauvegardé !', 'success');
      mergeContact(data || c);
    }
  } else {
    c.id = c.id || 'local_' + Date.now();
    addPending({ t:'upsert', d: c });
    mergeContact(c);
    toast('📱 Sauvegardé localement (hors-ligne)', 'warning');
  }
  filtered = [...contacts];
  filterC();
  if (curPage === 'dashboard') renderDash();
  closeCModal();
}

function mergeContact(c) {
  const i = contacts.findIndex(x => x.id === c.id);
  if (i >= 0) contacts[i] = c; else contacts.unshift(c);
}

function addPending(op) { pending.push(op); savePending(); }

async function deleteC() {
  if (!editId || !isAdmin) return toast('❌ Action réservée à l\'Admin', 'error');
  showConfirm('🗑️ Supprimer ce contact ?', 'Cette action est irréversible.', async () => {
    const { error } = await sb.from('contacts').delete().eq('id', editId);
    if (!error) {
      contacts = contacts.filter(x => x.id !== editId);
      filtered = [...contacts];
      filterC();
      if (curPage === 'dashboard') renderDash();
      toast('🗑️ Contact supprimé', 'success');
      closeCModal();
    } else toast('❌ ' + error.message, 'error');
  });
}

