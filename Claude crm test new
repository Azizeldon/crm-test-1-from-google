  return T[type]?.[st] || T.email.lead;
}

// ─────────────────────────────────────────────
// IMPORT
// ─────────────────────────────────────────────
function trigImport() { $('imp-file').click(); }

async function handleImport(e) {
  const file = e.target.files[0];
  if (!file) return;
  toast('📂 Lecture du fichier…', 'info');
  const ext = file.name.split('.').pop().toLowerCase();
  let rows = [];
  if (ext==='csv'||ext==='txt') rows = parseCSV(await file.text());
  else if (ext==='xlsx'||ext==='xls') rows = await parseXLSX(file);

  if (!rows.length) return toast('⚠️ Aucune donnée trouvée dans le fichier', 'warning');
  toast(`📥 ${rows.length} ligne(s) détectée(s), import…`, 'info');

  const toIns = rows.map(r => ({
    prenom:    r.prenom||r.Prenom||r['Prénom']||r.firstname||r['First Name']||r.name||'',
    nom:       r.nom||r.Nom||r.lastname||r['Last Name']||'',
    email:     r.email||r.Email||r['E-mail']||r.mail||'',
    phone:     r.phone||r.Phone||r.Telephone||r['Téléphone']||r.tel||r.mobile||'',
    societe:   r.societe||r.Societe||r.Société||r.Company||r.company||r.entreprise||'',
    status:    normStatus(r.status||r.Status||r.Statut||'lead'),
    notes:     r.notes||r.Notes||r.commentaire||'',
    ca_estime: parseFloat(r.ca||r.CA||r['CA Estimé']||r.revenue||0)||0,
    user_id:   me.id,
    created_at: new Date().toISOString(),
    updated_at: new Date().toISOString()
  }));

  if (online) {
    const { data, error } = await sb.from('contacts').insert(toIns).select();
    if (error) toast('❌ Erreur import : '+error.message, 'error');
    else {
      contacts.unshift(...(data||[]));
      filtered = [...contacts];
      filterC();
      if (curPage==='dashboard') renderDash();
      toast(`✅ ${toIns.length} contacts importés !`, 'success');
    }
  } else {
    toIns.forEach(c => { c.id='local_'+Date.now()+Math.random(); addPending({t:'upsert',d:c}); });
    contacts.unshift(...toIns);
    filtered = [...contacts];
    filterC();
    toast(`📱 ${toIns.length} contacts en attente de sync`, 'warning');
  }
  e.target.value = '';
}

function parseCSV(txt) {
  const lines = txt.split(/\r?\n/).filter(l=>l.trim());
  if (!lines.length) return [];
  const sep = lines[0].includes(';') ? ';' : lines[0].includes('\t') ? '\t' : ',';
  const hdrs = lines[0].split(sep).map(h=>h.trim().replace(/^"|"$/g,''));
  return lines.slice(1).map(l => {
    const vals = l.split(sep).map(v=>v.trim().replace(/^"|"$/g,''));
    const o = {};
    hdrs.forEach((h,i)=>o[h]=vals[i]||'');
    return o;
  });
}

function parseXLSX(file) {
  return new Promise(res => {
    const r = new FileReader();
    r.onload = e => {
      const wb = XLSX.read(e.target.result,{type:'binary'});
      res(XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{defval:''}));
    };
    r.readAsBinaryString(file);
  });
}

function normStatus(s) {
  s = (s||'').toLowerCase();
  if (s.includes('client')||s.includes('won')) return 'client';
  if (s.includes('prospect')) return 'prospect';
  if (s.includes('rappel')||s.includes('call back')) return 'rappel';
  if (s.includes('perdu')||s.includes('lost')||s.includes('non')||s.includes('no')) return 'lost';
  return 'lead';
}

// ─────────────────────────────────────────────
// EXPORT XLSX
// ─────────────────────────────────────────────
async function exportXLSX() {
  if (!isAdmin) return toast('❌ Réservé à l\'Admin', 'error');
  toast('📥 Génération du fichier…', 'info');
  const { data, error } = await sb.from('contacts').select('*').order('created_at',{ascending:false});
  if (error) return toast('❌ Erreur export', 'error');
  const rows = (data||[]).map(c=>({
    'Prénom':c.prenom||'','Nom':c.nom||'','Email':c.email||'','Téléphone':c.phone||'',
    'Société':c.societe||'','Statut':sLabel(c.status),'CA Estimé (€)':c.ca_estime||0,
    'Notes':c.notes||'','Créé le':fDate(c.created_at),'Modifié le':fDate(c.updated_at)
  }));
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rows), 'NexCRM');
  XLSX.writeFile(wb, `NexCRM_Export_${new Date().toISOString().split('T')[0]}.xlsx`);
  toast('✅ Export réussi !', 'success');
}

