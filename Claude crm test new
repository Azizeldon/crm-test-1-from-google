function doSend(ch, c, msg) {
  const phone = (c.phone||'').replace(/\D/g,'');
  const email = c.email || '';
  const enc   = encodeURIComponent(msg);
  if (ch==='whatsapp'&&phone) window.open(`https://wa.me/${phone}?text=${enc}`,'_blank');
  else if (ch==='sms'&&phone) window.open(`sms:${phone}?body=${enc}`,'_blank');
  else if (ch==='email'&&email) window.open(`mailto:${email}?subject=Message&body=${enc}`,'_blank');
  else { navigator.clipboard.writeText(msg).then(()=>toast('📋 Copié !','success')); }
}

