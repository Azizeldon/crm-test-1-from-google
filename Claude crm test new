// NOTIFICATIONS
// ─────────────────────────────────────────────
function toast(msg, type='info') {
  const map = {
    success: 'background:linear-gradient(135deg,rgba(132,204,22,.22),rgba(132,204,22,.1));border:1px solid rgba(132,204,22,.35)',
    error:   'background:linear-gradient(135deg,rgba(244,63,94,.22),rgba(244,63,94,.1));border:1px solid rgba(244,63,94,.35)',
    warning: 'background:linear-gradient(135deg,rgba(245,158,11,.22),rgba(245,158,11,.1));border:1px solid rgba(245,158,11,.35)',
    info:    'background:linear-gradient(135deg,rgba(99,102,241,.22),rgba(99,102,241,.1));border:1px solid rgba(99,102,241,.35)'
  };
  const el = document.createElement('div');
  el.className = 'toast glass';
  el.style.cssText = map[type]||map.info;
  el.innerHTML = `<div class="text-sm font-semibold" style="color:var(--text)">${msg}</div>`;
  $('toasts').appendChild(el);
  setTimeout(()=>{ el.classList.add('toast-out'); setTimeout(()=>el.remove(),320); }, 3600);
}

function checkRappels() {
  const n = contacts.filter(c=>c.status==='rappel').length;
  if (n > 0) toast(`🔔 ${n} contact${n>1?'s':''} à rappeler !`, 'warning');
}

async function askNotif() {
  if (!('Notification' in window)) return toast('Notifications non supportées','warning');
  const p = await Notification.requestPermission();
  if (p==='granted') {
    toast('✅ Notifications activées !','success');
    new Notification('NexCRM ⚡', { body: 'Vous recevrez vos rappels de prospection.' });
  } else toast('Notifications refusées','warning');
}

