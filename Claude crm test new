<script>
// ─────────────────────────────────────────────
// CONFIG
// ─────────────────────────────────────────────
const SB_URL   = 'https://tkikhtpzpixzscpkewlh.supabase.co';
const SB_KEY   = 'sb_publishable_or9nFB9PectQNg5BFtTrAQ_UuX_tBB2';
const ADM_EMAIL = 'elaidi.aziz10.if@gmail.com';

const { createClient } = supabase;
const sb = createClient(SB_URL, SB_KEY);

// ─────────────────────────────────────────────
// STATE
// ─────────────────────────────────────────────
let me = null, profile = null, isAdmin = false;
let contacts = [], filtered = [];
let statusFilter = 'all';
let editId = null;
let pending = JSON.parse(localStorage.getItem('nx_pending') || '[]');
let online = navigator.onLine;
let charts = {};
let confCb = null;
let modalContact = null;
let aiContact = null, aiMsg = '';

// ─────────────────────────────────────────────
// INIT
// ─────────────────────────────────────────────
(async () => {
  const { data: { session } } = await sb.auth.getSession();
  if (session?.user) { me = session.user; await loadProfile(); showApp(); }
  else showAuth();

  sb.auth.onAuthStateChange(async (ev, sess) => {
    if (ev === 'SIGNED_IN' && sess?.user) { me = sess.user; await loadProfile(); showApp(); }
    if (ev === 'SIGNED_OUT') { me = null; showAuth(); }
  });

  window.addEventListener('online',  () => { online = true;  updateOffline(); syncPending(); });
  window.addEventListener('offline', () => { online = false; updateOffline(); });
  updateOffline();

  // SW for PWA offline cache
  if ('serviceWorker' in navigator) {
    const sw = `self.addEventListener('install',()=>self.skipWaiting());self.addEventListener('activate',()=>clients.claim());self.addEventListener('fetch',e=>e.respondWith(caches.open('nx').then(c=>c.match(e.request).then(r=>r||fetch(e.request).then(res=>{c.put(e.request,res.clone());return res}).catch(()=>new Response('',{status:503}))))));`;
    const blob = new Blob([sw], { type: 'application/javascript' });
    navigator.serviceWorker.register(URL.createObjectURL(blob)).catch(() => {});
  }
})();

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────
function switchTab(t) {
  const isIn = t === 'in';
  $('f-in').classList.toggle('hidden', !isIn);
  $('f-up').classList.toggle('hidden', isIn);
  $('t-in').style.cssText = isIn ? 'background:var(--accent);color:#fff' : 'color:var(--muted)';
  $('t-up').style.cssText = !isIn ? 'background:var(--accent);color:#fff' : 'color:var(--muted)';
  $('auth-err').classList.add('hidden');
}

async function doSignIn() {
  const email = $('si-email').value.trim();
  const pass  = $('si-pwd').value;
  if (!email || !pass) return authErr('Remplissez tous les champs');
  setBtnLoad('btn-si', 'si-txt', true);
  const { error } = await sb.auth.signInWithPassword({ email, password: pass });
  setBtnLoad('btn-si', 'si-txt', false, 'Se connecter →');
  if (error) authErr(error.message);
}

async function doSignUp() {
  const name  = $('su-name').value.trim();
  const email = $('su-email').value.trim();
  const pass  = $('su-pwd').value;
  if (!name || !email || !pass) return authErr('Remplissez tous les champs');
  if (pass.length < 6) return authErr('Mot de passe trop court (min. 6 caractères)');
  setBtnLoad('btn-su', 'su-txt', true);
  const { data, error } = await sb.auth.signUp({ email, password: pass, options: { data: { full_name: name } } });
  setBtnLoad('btn-su', 'su-txt', false, 'Créer mon compte →');
  if (error) return authErr(error.message);
  if (data.user) {
    await sb.from('profiles').upsert({ id: data.user.id, email, full_name: name, role: email === ADM_EMAIL ? 'admin' : 'user', created_at: new Date().toISOString() });
    toast('✅ Compte créé ! Vérifiez votre email.', 'success');
    switchTab('in');
  }
}

async function doSignOut() {
  await sb.auth.signOut();
  contacts = []; filtered = []; me = null; profile = null;
  closeProfile(); showAuth();
}

async function loadProfile() {
  isAdmin = me.email === ADM_EMAIL;
  const { data } = await sb.from('profiles').select('*').eq('id', me.id).single();
  profile = data || { id: me.id, email: me.email, full_name: me.user_metadata?.full_name || me.email, role: isAdmin ? 'admin' : 'user' };
  if (!data) await sb.from('profiles').upsert(profile);
  if (me.email === ADM_EMAIL) { isAdmin = true; profile.role = 'admin'; }
}

function authErr(m) { const e = $('auth-err'); e.textContent = m; e.classList.remove('hidden'); }
function setBtnLoad(bid, tid, loading, txt = '') {
  const b = $(bid); const t = $(tid);
  b.disabled = loading;
  t.innerHTML = loading ? '<span class="loader" style="width:16px;height:16px;border-width:2px"></span>' : txt;
}

// ─────────────────────────────────────────────
// SHOW / HIDE
// ─────────────────────────────────────────────
function showAuth() { $('auth-screen').classList.remove('hidden'); $('app').classList.add('hidden'); }
function showApp()  {
  $('auth-screen').classList.add('hidden');
  $('app').classList.remove('hidden');
  setupApp();
  loadContacts();
}

function setupApp() {
  const n = profile?.full_name || me.email;
  const e = me.email;
  const rb = isAdmin ? '<span class="badge b-admin">⚡ Admin</span>' : '<span class="badge b-lead">Utilisateur</span>';
  ['s-name','pm-name'].forEach(id => $(id) && ($(id).textContent = n));
  ['s-email','pm-email'].forEach(id => $(id) && ($(id).textContent = e));
  ['s-role','pm-role'].forEach(id => $(id) && ($(id).innerHTML = rb));
  $('avatar-btn').textContent = isAdmin ? '⚡' : '👤';
  $('adm-zone').classList.toggle('hidden', !isAdmin);
  $('s-adm-users').classList.toggle('hidden', !isAdmin);
  setTimeout(checkRappels, 3500);
  updatePendCount();
}

// ─────────────────────────────────────────────
// NAVIGATION
// ─────────────────────────────────────────────
let curPage = 'dashboard';
function nav(p) {
  document.querySelectorAll('.page').forEach(el => el.classList.remove('on'));
  document.querySelectorAll('.nav-tab').forEach(el => el.classList.remove('on'));
  $('pg-' + p).classList.add('on');
  $('nt-' + p).classList.add('on');
  curPage = p;

  const titles = {
    dashboard: ['Dashboard', 'Vue globale'],
    contacts:  ['Contacts', contacts.length + ' contacts'],
    pipeline:  ['Pipeline', 'Suivi commercial'],
    history:   ['Historique', 'Interactions'],
    ai:        ['IA CRM', 'Intelligence artificielle'],
    settings:  ['Profil', isAdmin ? 'Administrateur' : 'Utilisateur']
  };
  const [t, s] = titles[p] || ['NexCRM', ''];
  $('hdr-title').textContent = t;
  $('hdr-sub').textContent   = s;
  $('fab').style.display     = p === 'contacts' ? 'flex' : 'none';

  if (p === 'dashboard') renderDash();
  if (p === 'pipeline')  renderPipe();
  if (p === 'history')   loadHistory();
  if (p === 'ai')        { renderHot(); fillAiSel(); }
  if (p === 'settings' && isAdmin) loadUsers();
}

// ─────────────────────────────────────────────
// OFFLINE
// ─────────────────────────────────────────────
function updateOffline() { $('offline-bar').classList.toggle('hidden', online); }
function savePending()   { localStorage.setItem('nx_pending', JSON.stringify(pending)); updatePendCount(); }
function updatePendCount() { $('pend-count') && ($('pend-count').textContent = pending.length); }

async function syncPending() {
  if (!pending.length) return;
  $('sync-spin').classList.remove('hidden');
  for (const op of [...pending]) {
    try {
      if (op.t === 'upsert') await sb.from('contacts').upsert(op.d);
      else if (op.t === 'del') await sb.from('contacts').delete().eq('id', op.id);
      pending = pending.filter(x => x !== op);
    } catch {}
  }
  savePending();
  $('sync-spin').classList.add('hidden');
  if (!pending.length) { toast('✅ Synchronisation réussie !', 'success'); loadContacts(); }
}

// ─────────────────────────────────────────────
