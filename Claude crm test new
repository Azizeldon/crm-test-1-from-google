async function loadContacts() {
  $('c-skel').classList.remove('hidden');
  $('c-list').innerHTML = '';
  $('c-empty').classList.add('hidden');

  let q = sb.from('contacts').select('*').order('created_at', { ascending: false });
  if (!isAdmin) q = q.eq('user_id', me.id);
  const { data, error } = await q;
  $('c-skel').classList.add('hidden');

  if (error) {
    const c = localStorage.getItem('nx_contacts');
    contacts = c ? JSON.parse(c) : [];
    toast('⚠️ Hors-ligne — données locales chargées', 'warning');
  } else {
    contacts = data || [];
    localStorage.setItem('nx_contacts', JSON.stringify(contacts));
  }
  filtered = [...contacts];
  renderContacts();
  if (curPage === 'dashboard') renderDash();
  $('hdr-sub').textContent = contacts.length + ' contacts';
}

