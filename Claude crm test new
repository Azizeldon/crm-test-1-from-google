function renderDash() {
  const total   = contacts.length;
  const clients = contacts.filter(c => c.status === 'client').length;
  const conv    = total ? Math.round(clients/total*100) : 0;
  const ca      = contacts.reduce((s,c) => s+(c.ca_estime||0), 0);
  const rappels = contacts.filter(c => c.status === 'rappel');

  $('k-total').textContent   = total;
  $('k-clients').textContent = clients;
  $('k-conv').textContent    = conv + '%';
  $('k-prog').style.width    = conv + '%';
  $('k-ca').textContent      = ca >= 1000 ? (ca/1000).toFixed(1)+'k€' : ca+'€';
  $('rc-badge').textContent  = rappels.length;

  // Rappels list
  $('rappels-list').innerHTML = rappels.slice(0,4).map(c => `
    <div class="flex items-center justify-between p-3.5 rounded-2xl cursor-pointer" style="background:rgba(249,115,22,.1);border:1px solid rgba(249,115,22,.2)" onclick='openCModal(${jenc(c)})'>
